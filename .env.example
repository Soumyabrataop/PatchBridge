# PatchBridge Environment Configuration (Root)
# Copy this file to .env and fill in your values.
# Never commit .env or any .pem files to version control.

# -------------------------------------------------------------
# Server Configuration
# -------------------------------------------------------------
PORT=3001
FRONTEND_URL=http://localhost:5173

# -------------------------------------------------------------
# Google AI Studio API Key (Gemini / Gemma API - Free Tier)
# Get a free key at: https://aistudio.google.com/
# If unset, PatchBridge automatically uses the deterministic
# local triage engine (no AI key needed for offline demos).
# -------------------------------------------------------------
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-31b-it

# -------------------------------------------------------------
# GitHub App Configuration (for bot comments as "PatchBridge App[bot]")
#
# This is the PREFERRED auth method. The GitHub App posts comments
# and opens PRs as a bot identity, not your personal account.
#
# 1. Create a GitHub App at: https://github.com/settings/apps/new
#    - Webhook URL: https://<your-ngrok-url>/api/github/webhook
#    - Permissions: Issues (R/W), Contents (R/W), Pull requests (R/W)
#    - Subscribe to events: Issue comment, Issues
# 2. Generate a private key -> save as patchbridge-app.pem in repo root
# 3. Install the App on your repo -> note the Installation ID from the URL
# -------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_INSTALLATION_ID=
# Path to the downloaded .pem private key file (relative to repo root)
GITHUB_APP_PRIVATE_KEY_PATH=patchbridge-app.pem

# -------------------------------------------------------------
# GitHub OAuth App Configuration (for web UI login only)
#
# This is SEPARATE from the GitHub App above. It enables the
# "Login with GitHub" button in the web dashboard.
# Bot comment posting does NOT use these credentials.
#
# Create OAuth App at: https://github.com/settings/developers
#   Homepage URL:            http://localhost:5173
#   Authorization callback:  http://localhost:3001/api/auth/github/callback
# -------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -------------------------------------------------------------
# GitHub Webhook Secret (recommended)
# A random string you set in both your GitHub webhook settings
# and here. Used to verify webhook payloads are genuinely from GitHub.
# -------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=

# -------------------------------------------------------------
# GitHub Token fallback (optional)
# Used only if GitHub App credentials above are not configured.
# Can be a classic PAT with repo + issues scopes.
# -------------------------------------------------------------
GITHUB_TOKEN=

# -------------------------------------------------------------
# Frontend Configuration (Vite)
# -------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3001
