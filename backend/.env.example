# PatchBridge Backend Environment Variables

PORT=3001
FRONTEND_URL=http://localhost:5173

# Google AI Studio API Key (Gemini / Gemma API - Free Tier)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemma / Gemini model configuration
